{
  "name": "dsh-usage-ledger",
  "version": "0.1.2",
  "description": "Durable cross-session token usage ledger for DeepSeek Harness, with a Context Insights-style page that keeps counting sessions after they are deleted.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiyu-ljy/dsplugin.git"
  },
  "homepage": "https://github.com/xiyu-ljy/dsplugin#readme",
  "bugs": {
    "url": "https://github.com/xiyu-ljy/dsplugin/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "tokens",
    "usage",
    "sessions",
    "ledger"
  ]
}
